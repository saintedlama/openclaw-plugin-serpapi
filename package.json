{
  "name": "@saintedlama/openclaw-serpapi",
  "version": "1.1.0",
  "description": "OpenClaw plugin for web search via SerpAPI",
  "main": "index.ts",
  "files": [
    "*.ts",
    "!*.test.ts",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --strict",
    "test": "vitest run"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "serpapi",
    "web-search"
  ],
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "serpapi": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
